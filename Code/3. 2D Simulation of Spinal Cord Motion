def load_data() -> tuple[pd.DataFrame, ColumnMap]:
    d = pd.read_excel(FILE_PATH, sheet_name=SHEET_NAME)

    data = d[d['maximum_stenosis_BL']==4]

    # Preserve the original database row before any filtering/reset_index().
    # Several downstream audit/deduplication functions rely on this stable key.
    if "source_row_index" not in data.columns:
        data.insert(0, "source_row_index", data.index)

    data, motion_columns = build_simulation_variables(data)
    columns = resolve_columns(data, motion_columns)

    data = data.copy()
    data[columns.all_columns] = data[columns.all_columns].apply(
        pd.to_numeric,
        errors="coerce",
    )
    return data, columns

