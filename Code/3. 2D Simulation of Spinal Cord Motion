def apply_data_condition(
    series: pd.Series,
    operator: str,
    value: object,
) -> pd.Series:
    """Evaluate one configured DATA subgroup condition."""
    if operator == "==":
        return series == value
    if operator == "!=":
        return series != value
    if operator == ">":
        return series > value
    if operator == ">=":
        return series >= value
    if operator == "<":
        return series < value
    if operator == "<=":
        return series <= value
    if operator == "in":
        return series.isin(value)
    if operator == "not in":
        return ~series.isin(value)

    raise ValueError(f"Unsupported DATA_GROUPS operator: {operator!r}")


def select_data_group(
    data: pd.DataFrame,
    group: dict[str, object],
) -> pd.DataFrame:
    """
    Select a subgroup directly from database variables.

    Multiple conditions inside one group are combined with AND.
    """
    conditions = group.get("conditions", ())
    if not conditions:
        raise ValueError(
            f"DATA group {group.get('name', '<unnamed>')!r} has no conditions."
        )

    mask = pd.Series(True, index=data.index)

    for column_name, operator, value in conditions:
        if column_name not in data.columns:
            raise KeyError(
                f"DATA_GROUPS column {column_name!r} does not exist in the database."
            )
        mask &= apply_data_condition(
            data[column_name],
            str(operator),
            value,
        ).fillna(False)

    return data.loc[mask].copy().reset_index(drop=True)


