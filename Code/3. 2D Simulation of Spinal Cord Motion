def population_average_row(
    data: pd.DataFrame,
    columns: ColumnMap,
) -> pd.Series:
    result = pd.Series(index=columns.all_columns, dtype=float)

    continuous = [
        *columns.canal_ap.values(),
        *columns.cord_ap.values(),
        *columns.motion.values(),
    ]
    result[continuous] = data[continuous].mean(axis=0, skipna=True)

    categorical_columns = [
        *columns.stenosis.values(),
        *columns.compression_side.values(),
        *([columns.maximum_stenosis] if columns.maximum_stenosis else []),
    ]
    for column in categorical_columns:
        valid = data[column].dropna().round().astype(int)
        result[column] = (
            float(valid.mode().iloc[0])
            if len(valid)
            else np.nan
        )

    return result


