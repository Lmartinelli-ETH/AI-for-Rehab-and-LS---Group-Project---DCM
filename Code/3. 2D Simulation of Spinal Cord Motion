def x_at(y_value: float, y: np.ndarray, x_values: np.ndarray) -> float:
    return float(np.interp(y_value, y, x_values))


def boundary_polygon(
    y: np.ndarray,
    left: np.ndarray,
    right: np.ndarray,
) -> np.ndarray:
    return np.vstack(
        [
            np.column_stack([left, y]),
            np.column_stack([right[::-1], y[::-1]]),
        ]
    )


def draw_vertebral_body(
    ax: Axes,
    geometry: DenseGeometry,
    y_center: float,
    compact: bool,
) -> None:
    height = 0.72
    top = y_center + height / 2.0
    bottom = y_center - height / 2.0
    base_body_left = -2.22 if not compact else -2.05

    canal_reference = float(np.median(geometry.canal_left))
    local_shift = (
        x_at(y_center, geometry.y, geometry.canal_left) - canal_reference
    ) * 0.55
    body_left = base_body_left + local_shift

    right_top = (
        x_at(top, geometry.y, geometry.canal_left)
        - ANTERIOR_LIGAMENT_GAP
    )
    right_mid = (
        x_at(y_center, geometry.y, geometry.canal_left)
        - ANTERIOR_LIGAMENT_GAP
    )
    right_bottom = (
        x_at(bottom, geometry.y, geometry.canal_left)
        - ANTERIOR_LIGAMENT_GAP
    )

    vertices = [
        (body_left + 0.08, top),
        (body_left - 0.04, y_center + 0.16),
        (body_left + 0.03, bottom),
        (right_bottom, bottom),
        (right_mid, y_center),
        (right_top, top),
        (body_left + 0.08, top),
    ]
    codes = [
        MplPath.MOVETO,
        MplPath.CURVE3,
        MplPath.CURVE3,
        MplPath.LINETO,
        MplPath.CURVE3,
        MplPath.CURVE3,
        MplPath.CLOSEPOLY,
    ]

    ax.add_patch(
        PathPatch(
            MplPath(vertices, codes),
            facecolor="#efe7d8",
            edgecolor="#33383c",
            linewidth=0.95 if not compact else 0.65,
            zorder=2,
        )
    )


