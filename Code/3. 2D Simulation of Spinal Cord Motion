def make_simulation_cmap() -> LinearSegmentedColormap:
    """Create the simulation colormap from the editable SETTINGS above."""
    positions = [float(position) for position, _ in SIMULATION_COLORS]

    if not SIMULATION_COLORS:
        raise ValueError("SIMULATION_COLORS must contain at least one color.")

    if positions[0] != 0.0 or positions[-1] != 1.0:
        raise ValueError(
            "SIMULATION_COLORS must start at position 0.0 and end at 1.0."
        )

    if any(not 0.0 <= position <= 1.0 for position in positions):
        raise ValueError("All SIMULATION_COLORS positions must be between 0 and 1.")

    if any(b <= a for a, b in zip(positions, positions[1:])):
        raise ValueError(
            "SIMULATION_COLORS positions must be strictly increasing."
        )

    return LinearSegmentedColormap.from_list(
        SIMULATION_CMAP_NAME,
        SIMULATION_COLORS,
    )


