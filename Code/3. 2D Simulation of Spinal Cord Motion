def enabled_optional_mapping(
    configured: dict[str, object] | None | bool,
) -> dict[str, str]:
    """Return only enabled optional database columns.

    The complete optional mapping can be disabled with None/False, and single
    entries may likewise be set to None/False.
    """
    if configured is None or configured is False:
        return {}
    if not isinstance(configured, dict):
        raise TypeError("Optional column configuration must be a dict, None, or False.")
    return {
        key: str(value)
        for key, value in configured.items()
        if value is not None and value is not False and str(value).strip()
    }


def resolve_columns(
    dataframe: pd.DataFrame,
    motion_columns: dict[str, str],
) -> ColumnMap:
    stenosis_columns = enabled_optional_mapping(STENOSIS_COLUMNS)
    compression_side_columns = enabled_optional_mapping(COMPRESSION_SIDE_COLUMNS)
    maximum_stenosis_column = (
        str(MAXIMUM_STENOSIS_COLUMN)
        if MAXIMUM_STENOSIS_COLUMN is not None
        and MAXIMUM_STENOSIS_COLUMN is not False
        and str(MAXIMUM_STENOSIS_COLUMN).strip()
        else None
    )

    exact_columns = {
        **CANAL_AP_COLUMNS,
        **CORD_AP_COLUMNS,
        **motion_columns,
        **stenosis_columns,
        **compression_side_columns,
    }
    missing = [
        column_name
        for column_name in exact_columns.values()
        if column_name not in dataframe.columns
    ]

    if (
        maximum_stenosis_column is not None
        and maximum_stenosis_column not in dataframe.columns
    ):
        missing.append(maximum_stenosis_column)
    if PATIENT_ID_COLUMN not in dataframe.columns:
        missing.append(PATIENT_ID_COLUMN)

    if missing:
        raise KeyError(
            "The following database columns are missing:\n"
            + "\n".join(f"- {name}" for name in missing)
        )

    return ColumnMap(
        canal_ap=CANAL_AP_COLUMNS.copy(),
        cord_ap=CORD_AP_COLUMNS.copy(),
        motion=motion_columns.copy(),
        stenosis=stenosis_columns,
        compression_side=compression_side_columns,
        maximum_stenosis=maximum_stenosis_column,
    )


def patient_id_key(value: object) -> Optional[str]:
    """Stable key used only for duplicate detection."""
    if pd.isna(value):
        return None

    if isinstance(value, (int, np.integer)):
        return str(int(value))

    if isinstance(value, (float, np.floating)):
        numeric = float(value)
        if np.isfinite(numeric) and numeric.is_integer():
            return str(int(numeric))
        return str(numeric)

    text = str(value).strip()
    if not text:
        return None

    try:
        numeric = float(text)
        if np.isfinite(numeric) and numeric.is_integer():
            return str(int(numeric))
    except ValueError:
        pass

    return text


def format_patient_id(value: object) -> str:
    """
    Display integer-like IDs without a decimal suffix.
    Example: 4.0 -> "4".
    """
    key = patient_id_key(value)
    if key is None:
        raise ValueError("Patient ID is missing.")
    return key


def filter_motion_complete_cases(
    data: pd.DataFrame,
    columns: ColumnMap,
) -> tuple[pd.DataFrame, pd.DataFrame]:
    """Keep the cohort fixed across modes using the original six motion columns."""
    required = list(COHORT_REQUIRED_MOTION_COLUMNS)
    missing_db = [column for column in required if column not in data.columns]
    if missing_db:
        raise KeyError(
            "Missing cohort-defining motion columns:\n"
            + "\n".join(f"- {column}" for column in missing_db)
        )
    numeric = data[required].apply(pd.to_numeric, errors="coerce")
    missing_motion = numeric.isna()
    keep_mask = ~missing_motion.any(axis=1)
    excluded_records = []
    for row_index in data.index[~keep_mask]:
        missing_columns = missing_motion.columns[
            missing_motion.loc[row_index].to_numpy()
        ].tolist()
        excluded_records.append({
            "source_row_index": data.loc[row_index, "source_row_index"]
            if "source_row_index" in data.columns
            else row_index,
            PATIENT_ID_COLUMN: data.loc[row_index, PATIENT_ID_COLUMN],
            "exclusion_reason": "missing_required_cohort_motion",
            "number_missing_required_motion_values": len(missing_columns),
            "missing_required_motion_columns": "; ".join(missing_columns),
        })
    return (
        data.loc[keep_mask].copy().reset_index(drop=True),
        pd.DataFrame(excluded_records),
    )


def deduplicate_patient_rows(
    data: pd.DataFrame,
    columns: ColumnMap,
) -> tuple[pd.DataFrame, pd.DataFrame]:
    """
    Ensure that one patient ID is plotted at most once.

    If the same ID occurs multiple times after the motion filter, keep the row
    with the largest number of available optional anatomy values. Ties are
    resolved by the earliest source row.
    """
    if not DEDUPLICATE_PATIENT_IDS:
        return data.reset_index(drop=True), pd.DataFrame()

    work = data.copy()

    # Defensive fallback: deduplication must never depend on load_data()
    # having created this helper column. If it is absent for any reason,
    # reconstruct a stable source-row identifier from the current index.
    if "source_row_index" not in work.columns:
        work.insert(0, "source_row_index", work.index)

    work["_patient_id_key"] = work[PATIENT_ID_COLUMN].map(patient_id_key)

    missing_id_mask = work["_patient_id_key"].isna()
    missing_id_report = work.loc[
        missing_id_mask,
        ["source_row_index", PATIENT_ID_COLUMN],
    ].copy()
    if not missing_id_report.empty:
        missing_id_report["duplicate_action"] = "excluded_missing_patient_id"

    work = work.loc[~missing_id_mask].copy()

    anatomy_columns = columns.optional_anatomy_columns
    work["_anatomy_values_present"] = work[anatomy_columns].notna().sum(axis=1)

    duplicate_mask = work["_patient_id_key"].duplicated(keep=False)
    duplicate_rows = work.loc[
        duplicate_mask,
        [
            "source_row_index",
            PATIENT_ID_COLUMN,
            "_patient_id_key",
            "_anatomy_values_present",
        ],
    ].copy()

    work = work.sort_values(
        by=["_patient_id_key", "_anatomy_values_present", "source_row_index"],
        ascending=[True, False, True],
        kind="stable",
    )

    kept_source_rows = set(
        work.drop_duplicates("_patient_id_key", keep="first")[
            "source_row_index"
        ].tolist()
    )

    if not duplicate_rows.empty:
        duplicate_rows["duplicate_action"] = duplicate_rows[
            "source_row_index"
        ].map(
            lambda row_index: (
                "kept_best_anatomy_row"
                if row_index in kept_source_rows
                else "excluded_duplicate_patient_id"
            )
        )

    deduplicated = work.drop_duplicates("_patient_id_key", keep="first").copy()
    deduplicated = deduplicated.sort_values("source_row_index", kind="stable")
    deduplicated = deduplicated.drop(
        columns=["_patient_id_key", "_anatomy_values_present"]
    ).reset_index(drop=True)

    duplicate_report = pd.concat(
        [duplicate_rows, missing_id_report],
        ignore_index=True,
        sort=False,
    )

    if deduplicated.empty:
        raise ValueError("No identifiable patients remain after ID validation.")

    return deduplicated, duplicate_report


