            key = safe_filename(sim_label)
            record[f"{key}_simulation_raw"] = raw_value
            record[f"{key}_simulation_used"] = filled_value

        record["maximum_stenosis_level_used"] = profile.maximum_level
        records.append(record)

    pd.DataFrame(records).to_csv(
        OUTPUT_DIRECTORY / "values_used_by_patient.csv",
        index=False,
    )


# =============================================================================
# 5. Numerical helpers
# =============================================================================

def finite_median(values: np.ndarray, fallback: float) -> float:
    values = np.asarray(values, dtype=float)
    values = values[np.isfinite(values)]
    return float(np.median(values)) if values.size else float(fallback)


def interpolate_missing(
    x: np.ndarray,
    values: np.ndarray,
    fallback: float,
) -> np.ndarray:
    """
    Fill missing control-point values with straight/linear interpolation.

    - Between two known points: linear interpolation.
    - Outside the known range: nearest known endpoint is extended.
    - One known point only: constant value.
    - No known points: fallback value.
    """
    x = np.asarray(x, dtype=float)
    values = np.asarray(values, dtype=float)
    if x.size != values.size:
        raise ValueError(
            f"interpolate_missing: {x.size} coordinates but {values.size} values. "
            "Check the active simulation mode."
        )
    valid = np.isfinite(values)

    if not valid.any():
        return np.full_like(values, fallback, dtype=float)

    if valid.sum() == 1:
        return np.full_like(values, float(values[valid][0]), dtype=float)

    order = np.argsort(x)
    xs = x[order]
    vs = values[order]
    valid_sorted = np.isfinite(vs)

    interpolated_sorted = np.interp(
        xs,
        xs[valid_sorted],
        vs[valid_sorted],
    )

    result = np.empty_like(interpolated_sorted)
    result[order] = interpolated_sorted
    return result


def pchip_interpolate(
    x: np.ndarray | float,
    node_x: np.ndarray,
    node_values: np.ndarray,
) -> np.ndarray:
    """
    Shape-preserving cubic Hermite interpolation (PCHIP).

    PCHIP passes exactly through the control points, rounds sharp corners, and
    avoids the overshoot/new extrema that a conventional cubic spline may
    introduce. Outside the measured control-point range, the nearest endpoint
    value is held constant.

    Important:
    Missing control-point values are NOT handled here. They are filled first
    with `interpolate_missing()`, which remains strictly linear.
    """
    xp = np.asarray(node_x, dtype=float)
    fp = np.asarray(node_values, dtype=float)
    if xp.size != fp.size:
        raise ValueError(
            f"pchip_interpolate: {xp.size} coordinates but {fp.size} values."
        )

    order = np.argsort(xp)
    xp = xp[order]
    fp = fp[order]

    if xp.size < 2:
        return np.full_like(
            np.asarray(x, dtype=float),
            fp[0] if fp.size else np.nan,
            dtype=float,
        )

    x_array = np.asarray(x, dtype=float)

    # Clamp evaluation positions to the measured range so that no artificial
    # extrapolation curve is created above/below the available anatomy.
    x_clamped = np.clip(x_array, xp[0], xp[-1])

    interpolator = PchipInterpolator(
        xp,
        fp,
        extrapolate=False,
    )

    return np.asarray(interpolator(x_clamped), dtype=float)


def robust_motion_norm(
    data: pd.DataFrame,
    columns: ColumnMap,
) -> mpl.colors.Normalize:

    if SCALE_EQUAL == 'True' and SCALE_ALL_EQUAL != 'True':
        # Special case: shared color scale for ratio_to_min and diff_to_min
        if SIMULATION_CONFIG.mode in {"ratio_to_min", "diff_to_min"}:

            source_columns = [
                format_simulation_column(
                    MODE_RAW["column_template"], i
                )
                for i in range(len(LEVELS))
            ]

            raw_values = data[source_columns].apply(
                pd.to_numeric, errors="coerce"
            )

            minimum = raw_values.min(axis=1, skipna=True)

            ratio_values = raw_values.div(
                minimum.replace(0, np.nan), axis=0
            )

            diff_values = raw_values.sub(minimum, axis=0)

            # Combine both transformations for a shared scale
            values = np.concatenate([
                ratio_values.to_numpy(dtype=float).ravel(),
                diff_values.to_numpy(dtype=float).ravel()
            ])

        else:
            # Original behavior for all other simulation modes
            values = data[
                columns.motion_required_columns
            ].to_numpy(dtype=float).ravel()

        values = values[np.isfinite(values)]

        if values.size == 0:
            raise ValueError("No valid motion values were found.")

        if MOTION_FIXED_RANGE is not None:
            vmin, vmax = MOTION_FIXED_RANGE
        else:
            vmin, vmax = np.percentile(
                values, MOTION_PERCENTILE_RANGE
            )

        if np.isclose(vmin, vmax):
            padding = max(abs(vmin) * 0.10, 0.10)
            vmin -= padding
            vmax += padding

        return mpl.colors.Normalize(
            vmin=float(vmin),
            vmax=float(vmax)
        )

    elif SCALE_EQUAL == 'False':
        values = data[columns.motion_required_columns].to_numpy(dtype=float).ravel()
        values = values[np.isfinite(values)]

        if values.size == 0:
            raise ValueError("No valid motion values were found.")

        if MOTION_FIXED_RANGE is not None:
            vmin, vmax = MOTION_FIXED_RANGE
        else:
            vmin, vmax = np.percentile(values, MOTION_PERCENTILE_RANGE)

        if np.isclose(vmin, vmax):
            padding = max(abs(vmin) * 0.10, 0.10)
            vmin -= padding
            vmax += padding

        return mpl.colors.Normalize(vmin=float(vmin), vmax=float(vmax))

    elif SCALE_ALL_EQUAL == 'True':
        all_values = []

        # Collect values from every simulation mode
        for mode in ALL_SIMULATION_MODES:

            config = resolve_simulation_config(mode)

            # Temporarily use this mode's specifications
            global SIMULATION_VARIABLES
            previous_variables = SIMULATION_VARIABLES

            try:
                SIMULATION_VARIABLES = config.specifications
                mode_data, resolved = build_simulation_variables(data)
            finally:
                SIMULATION_VARIABLES = previous_variables

            values = mode_data[
                list(resolved.values())
            ].to_numpy(dtype=float).ravel()

            all_values.append(values)

        # Combine all simulation values
        values = np.concatenate(all_values)
        values = values[np.isfinite(values)]

        if values.size == 0:
            raise ValueError("No valid motion values were found.")

        if MOTION_FIXED_RANGE is not None:
            vmin, vmax = MOTION_FIXED_RANGE
        else:
            vmin, vmax = np.percentile(
                values,
                MOTION_PERCENTILE_RANGE
            )

        if np.isclose(vmin, vmax):
            padding = max(abs(vmin) * 0.10, 0.10)
            vmin -= padding
            vmax += padding

        return mpl.colors.Normalize(
            vmin=float(vmin),
            vmax=float(vmax)
        )



def detect_motion_hotspots(values):
    values = np.asarray(values, dtype=float)

    if not np.all(np.isfinite(values)):
        return []

    hotspots = []
    n = len(values)

    for i in range(n):
        if i == 0:
            if not HOTSPOT_INCLUDE_ENDPOINTS:
                continue
            neighbors = [values[1]]

        elif i == n - 1:
            if not HOTSPOT_INCLUDE_ENDPOINTS:
                continue
            neighbors = [values[n - 2]]

        else:
            neighbors = [values[i - 1], values[i + 1]]

        # Strict local maximum
        if all(values[i] > neighbor for neighbor in neighbors):
            difference = values[i] - max(neighbors)

            if difference >= HOTSPOT_MIN_PROMINENCE:
                hotspots.append(i)

    return hotspots


def add_hotspot_groups(data):
    data = data.copy()

    motion_columns = [
        format_simulation_column(
            MODE_RAW["column_template"], i
        )
        for i in range(len(LEVELS))
    ]

    values = data[motion_columns].apply(
        pd.to_numeric, errors="coerce"
    )

    hotspot_indices = [
        detect_motion_hotspots(row)
        for row in values.to_numpy(dtype=float)
    ]

    data["hotspot_count"] = [
        len(indices) for indices in hotspot_indices
    ]

    data["hotspot_levels"] = [
        ", ".join(LEVELS[i] for i in indices)
        for indices in hotspot_indices
    ]

    return data


def decode_maximum_level(value: float) -> Optional[str]:
    if not np.isfinite(value):
        return None
    return MAXIMUM_STENOSIS_CODE_TO_LEVEL.get(int(round(value)))


def build_profile(
    row: pd.Series,
    columns: ColumnMap,
    global_motion_fallback: float,
) -> SpineProfile:
    canal_ap_raw = row[list(columns.canal_ap.values())].to_numpy(dtype=float)
    cord_ap_raw = row[list(columns.cord_ap.values())].to_numpy(dtype=float)
    motion_raw = row[list(columns.motion.values())].to_numpy(dtype=float)
    stenosis_raw = np.array([
        float(row[columns.stenosis[key]])
        if key in columns.stenosis else np.nan
        for key in SEGMENTS2
    ], dtype=float)
    compression_side_raw = np.array([
        float(row[columns.compression_side[key]])
        if key in columns.compression_side else np.nan
        for key in SEGMENTS
    ], dtype=float)

    # Study naming is segment-based for ALL C2...C7 measurements:
    # C2_* = C2/C3, C3_* = C3/C4, ..., C7_* = C7/T1.
    canal_ap = interpolate_missing(
        MEASUREMENT_Y, canal_ap_raw, finite_median(canal_ap_raw, 9.0)
    )
    cord_ap = interpolate_missing(
        MEASUREMENT_Y, cord_ap_raw, finite_median(cord_ap_raw, 5.5)
    )

    canal_ap = np.clip(canal_ap, 0.5, None)
    cord_ap = np.clip(cord_ap, 0.02, canal_ap)
    csf_ap = np.maximum(canal_ap - cord_ap, 0.0)

    motion_filled = interpolate_missing(
        SIMULATION_Y, motion_raw, global_motion_fallback
    )

    # Severity: 1 none, 2 mild, 3 moderate, 4 severe. Missing severity is
    # treated as no stenosis. Compression side: 1 anterior/left, 2 posterior/
    # right, 3 bilateral, 4 minor deformation. A missing/disabled side is kept
    # neutral instead of introducing an artificial directional displacement.
    stenosis_severity = np.where(np.isfinite(stenosis_raw), stenosis_raw, 1.0)
    stenosis_severity = np.clip(np.rint(stenosis_severity), 1, 4).astype(int)

    compression_side = np.where(
        np.isfinite(compression_side_raw), compression_side_raw, 3.0
    )
    compression_side = np.clip(np.rint(compression_side), 1, 4).astype(int)

    return SpineProfile(
        canal_ap_segment_mm=canal_ap,
        cord_ap_segment_mm=cord_ap,
        motion_segment_raw=motion_raw,
        motion_segment_filled=motion_filled,
        csf_ap_segment_mm=csf_ap,
        stenosis_severity_segment=stenosis_severity,
        compression_side_segment=compression_side,
        maximum_level=(
            decode_maximum_level(float(row[columns.maximum_stenosis]))
            if columns.maximum_stenosis is not None
            else None
        ),
        # Do not let categorical stenosis/side data push an imputed, standard-
        # sized cord from one canal wall to the other. Directional displacement
        # needs local measured AP support from both canal and cord.
        compression_geometry_supported_segment=(
            np.isfinite(canal_ap_raw[:len(SEGMENTS)])
            & np.isfinite(cord_ap_raw[:len(SEGMENTS)])
        ),
    )


# =============================================================================
# 6. Shape-preserving PCHIP canal / CSF / cord geometry
# =============================================================================

def level_to_inferior_segment_y(level: str) -> float:
    index = LEVELS.index(level)
    return float(MEASUREMENT_Y[index])


def anterior_csf_fraction_at_segments(profile: SpineProfile) -> np.ndarray:
    """Return the fraction of total CSF placed anterior to the cord."""
    fractions = np.full(len(SEGMENTS), 0.50, dtype=float)

    for index, (severity, side) in enumerate(zip(
        profile.stenosis_severity_segment,
        profile.compression_side_segment,
    )):
        severity = int(severity)
        side = int(side)

        if not profile.compression_geometry_supported_segment[index]:
            # The AP geometry at this segment was imputed/fallback-filled. Keep
            # the cord centered rather than creating a categorical side shift on
            # top of an unmeasured diameter.
            fractions[index] = 0.50
            continue

        if severity <= 1:
            fractions[index] = 0.50
            continue

        if side == 4:
            # Study code 4 denotes only minor deformation, so keep the shift
            # deliberately subtle.
            fractions[index] = MINOR_DEFORMATION_ANTERIOR_CSF_FRACTION
            continue

        if side == 3:
            # Bilateral compression is symmetric in the sagittal projection.
            # Its absolute narrowing is already represented by the measured
            # segmental canal AP diameter.
            fractions[index] = 0.50
            continue

        affected_fraction = STENOSIS_AFFECTED_SIDE_CSF_FRACTION[severity]
        if side == 2:  # posterior/right compression
            fractions[index] = 1.0 - affected_fraction
        else:  # anterior/left, including the physiological fallback
            fractions[index] = affected_fraction

    return fractions


def dense_geometry(profile: SpineProfile, points: int) -> DenseGeometry:
    """Create smooth, shape-preserving PCHIP canal, CSF and cord geometry."""
    y = np.linspace(-0.60, 5.30, points)

    # Canal and cord AP are measured at segment positions despite their C2...C7
    # database names. No additional artificial stenosis width reduction is added.
    canal_ap_mm = pchip_interpolate(
        y, MEASUREMENT_Y, profile.canal_ap_segment_mm
    )
    canal_ap_mm = np.clip(canal_ap_mm, 0.5, None)

    cord_ap_mm = pchip_interpolate(
        y, MEASUREMENT_Y, profile.cord_ap_segment_mm
    )
    cord_ap_mm = np.clip(cord_ap_mm, 0.02, canal_ap_mm)
    total_csf = np.maximum(
        (canal_ap_mm - cord_ap_mm) * MM_TO_PLOT,
        0.0,
    )

    centerline = np.zeros_like(y)
    canal_left = centerline - 0.5 * canal_ap_mm * MM_TO_PLOT
    canal_right = centerline + 0.5 * canal_ap_mm * MM_TO_PLOT
    cord_width = cord_ap_mm * MM_TO_PLOT

    # Severity and compression side distribute the CSF around the cord.
    # To keep normal anatomy centered above C2 and below C7, 0.50 is added as
    # an endpoint control value on both sides of the five stenosis segments.
    anterior_fraction_nodes = anterior_csf_fraction_at_segments(profile)
    distribution_y = np.concatenate([[LEVEL_Y[0]], SEGMENT_Y, [MEASUREMENT_Y[-1]]])
    distribution_values = np.concatenate([
        [0.50], anterior_fraction_nodes, [0.50]
    ])
    anterior_fraction = pchip_interpolate(
        y, distribution_y, distribution_values
    )
    anterior_fraction = np.clip(anterior_fraction, 0.0, 1.0)

    anterior_csf = total_csf * anterior_fraction
    posterior_csf = total_csf - anterior_csf

    cord_left = canal_left + anterior_csf
    cord_right = cord_left + cord_width
    cord_left = np.maximum(cord_left, canal_left)
    cord_right = np.minimum(cord_right, canal_right)

    # Motion values are segment-based despite their C2...C7 database names.
    motion = pchip_interpolate(y, SIMULATION_Y, profile.motion_segment_filled)

    return DenseGeometry(
        y=y,
        canal_left=canal_left,
        canal_right=canal_right,
        cord_left=cord_left,
        cord_right=cord_right,
        motion=motion,
    )


