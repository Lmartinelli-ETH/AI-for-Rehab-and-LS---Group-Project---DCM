def draw_annotations(
    ax: Axes,
    profile: SpineProfile,
    geometry: DenseGeometry,
    compact: bool,
    show_numbers: bool,
    canal_only: bool = False,
) -> None:
    level_x = (-0.92 if canal_only else (-2.52 if not compact else -2.32))
    info_x = 1.20 if canal_only else 1.58

    for level, y_center in zip(LEVELS, LEVEL_Y):
        ax.text(
            level_x, y_center, level, ha="right", va="center",
            fontsize=ANNOTATION_FONT_SIZE, fontweight="bold",
        )

    if show_numbers and not compact:
        simulation_by_y = {
            float(y): float(v)
            for y, v in zip(SIMULATION_Y, profile.motion_segment_raw)
        }
        for index, (segment, y_center) in enumerate(
            zip(MEASUREMENT_SEGMENTS, MEASUREMENT_Y)
        ):
            sim = simulation_by_y.get(float(y_center), np.nan)
            sim_text = f"{sim:.2f}" if np.isfinite(sim) else "-"
            ax.text(
                info_x, y_center,
                f"{segment}   Sim {sim_text}   |   "
                f"Canal {profile.canal_ap_segment_mm[index]:.2f} mm   |   "
                f"Cord {profile.cord_ap_segment_mm[index]:.2f} mm   |   "
                f"CSF {profile.csf_ap_segment_mm[index]:.2f} mm",
                ha="left", va="center", fontsize=ANNOTATION_FONT_SIZE,
            )

    if profile.maximum_level is not None:
        marker_y = level_to_inferior_segment_y(profile.maximum_level)
        marker_x = x_at(marker_y, geometry.y, geometry.canal_right) + (
            0.045 if canal_only else (0.075 if not compact else 0.040)
        )
        ax.scatter(
            [marker_x], [marker_y], marker="o",
            s=42 if not compact else 15, color="#a51f1f",
            edgecolor="white", linewidth=0.45, zorder=9,
        )


def draw_legend(ax: Axes, include_maximum_stenosis: bool = True) -> None:
    handles = [
        Patch(facecolor="#efe7d8", edgecolor="#33383c", label="Bone"),
        Patch(facecolor="#aec8d5", edgecolor="#3d454a", label="Disc"),
        Patch(facecolor="#d8f2f7", edgecolor="#33444b", label="CSF / canal"),
        Patch(facecolor="#5cc8ff", edgecolor="#263239", label="Cord / motion"),
    ]
    if include_maximum_stenosis:
        handles.append(
            Line2D(
                [0],
                [0],
                marker="o",
                linestyle="none",
                color="#a51f1f",
                markersize=5,
                label="Maximum stenosis",
            )
        )

    ax.legend(
        handles=handles,
        loc="lower center",
        bbox_to_anchor=(0.50, -0.080),
        ncol=3,
        frameon=False,
        fontsize=ANNOTATION_FONT_SIZE,
        handlelength=1.35,
        columnspacing=0.85,
    )


def add_method_box(fig: Figure) -> None:
    text = (
        "Missing anatomy is first filled from adjacent measurements. Visible "
        "AP, CSF and motion profiles are connected with shape-preserving PCHIP "
        "interpolation. Segmental canal AP defines the narrowing; stenosis "
        "severity and compression side determine how the available CSF is "
        "distributed around the cord."
    )
    fig.text(
        0.50,
        0.015,
        text,
        ha="center",
        va="bottom",
        fontsize=ANNOTATION_FONT_SIZE,
