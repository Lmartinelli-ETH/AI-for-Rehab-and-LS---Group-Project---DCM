                profile.compression_geometry_supported_segment[segment_index]
                and int(severity) > 1
                and int(side) in (1, 2, 4)
            )

        for sim_label, raw_value, filled_value in zip(
            SIMULATION_VALUE_LABELS,
            profile.motion_segment_raw,
            profile.motion_segment_filled,
