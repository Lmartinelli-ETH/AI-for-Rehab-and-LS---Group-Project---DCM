def run_one_simulation_mode(
    mode: str,
    comparison_root: Optional[Path] = None,
) -> dict[str, object]:
    """
    Run one concrete simulation mode.

    Cohort selection always uses COHORT_REQUIRED_MOTION_COLUMNS and is therefore
    identical across modes. The active mode changes only the simulated values.
    """
    config = activate_simulation_mode(mode)

    print("\n================ ACTIVE SIMULATION ================")
    print(f"Mode: {config.mode}")
    print(f"Title: {SIMULATION_TITLE}")
    print(f"Control points: {len(SIMULATION_Y)}")
    print("Resolved source definitions:")
    for label, spec in SIMULATION_VARIABLES.items():
        print(f"  {label}: {spec}")
    print("===================================================\n")

    raw_data, columns = load_data()

    # Determine hotspots before group selection
    raw_data = add_hotspot_groups(raw_data)

    data_group_columns = sorted({
        str(condition[0])
        for group in DATA_GROUPS
        for condition in group.get("conditions", ())
    })
    missing_group_columns = [
        column for column in data_group_columns
        if column not in raw_data.columns
    ]
    if missing_group_columns:
        raise KeyError(
            "The following DATA_GROUPS columns are missing:\n"
            + "\n".join(f"- {name}" for name in missing_group_columns)
        )

    # IMPORTANT: this filter is mode-independent.
    motion_filtered, exclusion_report = filter_motion_complete_cases(
        raw_data,
        columns,
    )
    data, duplicate_report = deduplicate_patient_rows(
        motion_filtered,
        columns,
    )

    if comparison_root is not None:
        base_output_directory = comparison_root / safe_filename(config.mode)
    elif SEPARATE_OUTPUT_BY_MODE:
        base_output_directory = OUTPUT_DIRECTORY / safe_filename(config.mode)
    else:
        base_output_directory = OUTPUT_DIRECTORY
    base_output_directory.mkdir(parents=True, exist_ok=True)

    exclusion_report.to_csv(
        base_output_directory / "excluded_incomplete_motion_rows.csv",
        index=False,
    )
    duplicate_report.to_csv(
        base_output_directory / "duplicate_patient_id_rows.csv",
        index=False,
    )

    pd.DataFrame(
        [{
            "raw_rows": len(raw_data),
            "rows_with_complete_motion": len(motion_filtered),
            "unique_patients_used": len(data),
            "excluded_incomplete_motion_rows": len(raw_data) - len(motion_filtered),
            "required_motion_value_count": len(COHORT_REQUIRED_MOTION_COLUMNS),
            "anatomy_required_for_inclusion": False,
            "deduplicate_patient_ids": DEDUPLICATE_PATIENT_IDS,
            "simulation_mode": config.mode,
        }]
    ).to_csv(
        base_output_directory / "filter_summary.csv",
        index=False,
    )

    print_terminal_audit(
        raw_data,
        data,
        columns,
        exclusion_report,
        duplicate_report,
    )

    motion_norm = robust_motion_norm(data, columns)
    all_motion = data[
        columns.motion_required_columns
    ].to_numpy(dtype=float).ravel()
    global_motion_fallback = finite_median(all_motion, 0.0)

    group_averages: dict[str, tuple[SpineProfile, DenseGeometry]] = {}
    comparison_averages: list[tuple[str, SpineProfile, DenseGeometry]] = []
    group_summary: list[dict[str, object]] = []

    if DATA_GROUPS:
        workflows = [
            (
                safe_filename(str(group["name"])),
                str(group["label"]),
                select_data_group(data, group),
                group,
            )
            for group in DATA_GROUPS
        ]
    else:
        workflows = [
            ("", "All patients", data.copy().reset_index(drop=True), None)
        ]

    for group_name, group_label, group_data, group_definition in workflows:
        group_summary.append({
            "group_name": group_name or "all_patients",
            "group_label": group_label,
            "conditions": (
                repr(group_definition.get("conditions", ()))
                if group_definition is not None
                else "complete cohort"
            ),
            "patient_count": len(group_data),
        })

        print(f"{group_label}: {len(group_data)} patients")
        if group_data.empty:
            print(f"Skipping empty DATA group: {group_label}")
            continue

        group_output_directory = (
            base_output_directory / group_name
            if group_name
            else base_output_directory
        )

        if comparison_root is not None:
            # Comparison only: compute one mean profile, without individual plots.
            average_row = population_average_row(group_data, columns)
            average_profile = build_profile(
                average_row, columns, global_motion_fallback,
            )
            average_geometry = dense_geometry(average_profile, GEOMETRY_POINTS_FULL)
            group_averages[group_label] = (average_profile, average_geometry)
            comparison_averages.append((group_label, average_profile, average_geometry))
            continue

        average_profile, average_geometry = run_standard_plots_for_data_group(
            group_data,
            columns,
            motion_norm,
            global_motion_fallback,
            group_output_directory,
            group_label,
        )
        group_averages[group_label] = (average_profile, average_geometry)
        comparison_averages.append(
            (group_label, average_profile, average_geometry)
        )

    pd.DataFrame(group_summary).to_csv(
        base_output_directory / "comparison_group_summary.csv",
        index=False,
    )

    if (
        comparison_root is None
        and DATA_GROUPS
        and CREATE_POPULATION_AVERAGE_COMPARISON
        and len(comparison_averages) >= 2
    ):
        fig = plot_population_average_comparison(
            comparison_averages,
            motion_norm,
        )
        fig.savefig(
            base_output_directory / "06_population_average_comparison.png",
            dpi=SAVE_DPI,
            bbox_inches="tight",
            facecolor="white",
        )
        plt.close(fig)

    print(f"Finished mode '{config.mode}': {base_output_directory.resolve()}")
    print(
        f"Unique patients used before DATA subgroup selection: "
        f"{len(data)} / {len(raw_data)} raw rows"
    )

    return {
        "config": config,
        "base_output_directory": base_output_directory,
        "patient_count": len(data),
        "raw_patient_count": len(raw_data),
        "motion_norm": motion_norm,
        "group_averages": group_averages,
    }


def run_comparison_mode() -> None:
    """
    Run all configured concrete modes and then create one additional figure
    per DATA group (or one for the full cohort) containing the three population
    averages as subplots.
    """
    comparison_root = OUTPUT_DIRECTORY / "comparison"
    comparison_root.mkdir(parents=True, exist_ok=True)

    results: list[dict[str, object]] = []
    expected_patient_count: Optional[int] = None

    for mode in selected_comparison_modes():
        result = run_one_simulation_mode(
            mode,
            comparison_root=comparison_root,
        )
        patient_count = int(result["patient_count"])

        if expected_patient_count is None:
            expected_patient_count = patient_count
        elif patient_count != expected_patient_count:
            raise RuntimeError(
                "Patient cohort changed between simulation modes. "
                f"Expected {expected_patient_count}, got {patient_count} "
                f"for mode {mode!r}. Cohort selection must be mode-independent."
            )

        results.append(result)

    # Determine all group labels available in the mode results.
    group_labels: list[str] = []
    for result in results:
        for label in result["group_averages"]:
            if label not in group_labels:
                group_labels.append(label)

    for group_label in group_labels:
        mode_averages = []

        for result in results:
            config = result["config"]
            group_averages = result["group_averages"]

            if group_label not in group_averages:
                continue

            profile, geometry = group_averages[group_label]
            mode_averages.append(
                (
                    config.mode,
                    config.title,
                    profile,
                    geometry,
                    result["motion_norm"],
                    config.colorbar_label,
                )
            )

        if len(mode_averages) != len(selected_comparison_modes()):
            print(
                f"Skipping cross-mode comparison for {group_label!r}: "
                f"only {len(mode_averages)} / {len(selected_comparison_modes())} "
                "mode averages are available."
            )
            continue

        fig = plot_simulation_mode_population_comparison(
            group_label,
            mode_averages,
        )
        filename = (
            "population_average_modes_comparison_"
            f"{safe_filename(group_label)}.png"
        )
        fig.savefig(
            comparison_root / filename,
            dpi=SAVE_DPI,
            bbox_inches="tight",
            facecolor="white",
        )
        if SHOW_FIGURES:
            plt.show(block=True)
        plt.close(fig)

    print("\n================ COMPARISON FINISHED ================")
    print(f"Modes: {', '.join(selected_comparison_modes())}")
    print(f"Same cohort in all modes: {expected_patient_count} patients")
    print(f"Output: {comparison_root.resolve()}")
    print("=====================================================\n")


def main() -> None:
    requested_mode = str(SIMULATION_MODE).strip().lower()

    if requested_mode == "comparison":
        run_comparison_mode()
    else:
        run_one_simulation_mode(requested_mode)


if __name__ == "__main__":
    main()
    if SHOW_FIGURES and str(SIMULATION_MODE).strip().lower() != "comparison":
        plt.show()
