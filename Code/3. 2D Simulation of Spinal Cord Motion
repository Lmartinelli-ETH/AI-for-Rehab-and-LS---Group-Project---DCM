def draw_bony_anatomy(
    ax: Axes,
    geometry: DenseGeometry,
    compact: bool,
) -> None:
    for y_center in LEVEL_Y:
        draw_vertebral_body(ax, geometry, y_center, compact)
        draw_posterior_element(ax, geometry, y_center, compact)

    for y_center in MEASUREMENT_Y:
        draw_disc(ax, geometry, y_center, compact)


def draw_canal_csf_and_cord(
    ax: Axes,
    geometry: DenseGeometry,
    motion_norm: mpl.colors.Normalize,
    cmap: mpl.colors.Colormap,
    compact: bool,
) -> None:
    canal_points = boundary_polygon(
        geometry.y,
        geometry.canal_left,
        geometry.canal_right,
    )
    cord_points = boundary_polygon(
        geometry.y,
        geometry.cord_left,
        geometry.cord_right,
    )

    ax.add_patch(
        Polygon(
            canal_points,
            closed=True,
            facecolor="#d8f2f7",
            edgecolor="#33444b",
            linewidth=1.20 if not compact else 0.78,
            zorder=3,
            joinstyle="round",
        )
    )

    raster_columns = (
        MOTION_RASTER_COLUMNS_COMPACT
        if compact
        else MOTION_RASTER_COLUMNS_FULL
    )
    raster = np.broadcast_to(
        geometry.motion[:, None],
        (geometry.motion.size, raster_columns),
    )

    image = ax.imshow(
        raster,
        origin="lower",
        extent=[
            float(np.min(geometry.cord_left)),
            float(np.max(geometry.cord_right)),
            geometry.y.min(),
            geometry.y.max(),
        ],
        cmap=cmap,
        norm=motion_norm,
        interpolation="bilinear",
        aspect="auto",
        zorder=4,
        rasterized=True,
    )

    clip_patch = Polygon(cord_points, closed=True, transform=ax.transData)
    image.set_clip_path(clip_patch)

    ax.add_patch(
        Polygon(
            cord_points,
            closed=True,
            facecolor="none",
            edgecolor="#263239",
            linewidth=0.95 if not compact else 0.62,
            zorder=5,
            joinstyle="round",
        )
    )


def draw_spinal_cord_only(ax, geometry, motion_norm, cmap, compact):
    """Draw only the motion-coloured spinal cord; no bone, discs, canal or CSF."""
    cord_points = boundary_polygon(geometry.y, geometry.cord_left, geometry.cord_right)
    raster_columns = MOTION_RASTER_COLUMNS_COMPACT if compact else MOTION_RASTER_COLUMNS_FULL
    raster = np.broadcast_to(geometry.motion[:, None], (geometry.motion.size, raster_columns))
    image = ax.imshow(
        raster, origin="lower",
        extent=[float(np.min(geometry.cord_left)), float(np.max(geometry.cord_right)), geometry.y.min(), geometry.y.max()],
        cmap=cmap, norm=motion_norm, interpolation="bilinear", aspect="auto", zorder=4, rasterized=True,
    )
    clip_patch = Polygon(cord_points, closed=True, transform=ax.transData)
    image.set_clip_path(clip_patch)
    ax.add_patch(Polygon(cord_points, closed=True, facecolor="none", edgecolor="#263239",
                         linewidth=0.95 if not compact else 0.62, zorder=5, joinstyle="round"))


