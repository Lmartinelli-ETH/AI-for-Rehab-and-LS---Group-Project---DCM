def plot_spine(
    profile: SpineProfile,
    geometry: DenseGeometry,
    motion_norm: mpl.colors.Normalize,
    patient_label: str,
    ax: Optional[Axes] = None,
    compact: bool = False,
    add_colorbar: bool = True,
    include_method_box: bool = False,
    show_numbers: bool = True,
    show_legend: bool = True,
    title_prefix: str = "",
    canal_only: bool = False,
    cord_only: bool = False,
) -> tuple[Figure, Axes]:
    if ax is None:
        if show_numbers:
            figsize = (11.8, 8.7)
        else:
            figsize = (8.6, 8.7)
        if include_method_box:
            figsize = (figsize[0], figsize[1] + 0.8)
        fig, ax = plt.subplots(figsize=figsize)
    else:
        fig = ax.figure

    cmap = mpl.colormaps[MOTION_CMAP]

    if cord_only:
        draw_spinal_cord_only(ax, geometry, motion_norm, cmap, compact)
    else:
        if not canal_only:
            draw_bony_anatomy(ax, geometry, compact=compact)
        draw_canal_csf_and_cord(ax, geometry, motion_norm, cmap, compact=compact)
    draw_annotations(
        ax, profile, geometry, compact=compact,
        show_numbers=show_numbers, canal_only=(canal_only or cord_only),
    )

    title_text = title_prefix if title_prefix else (
        f"Patient {patient_label}" if not compact else f"ID {patient_label}"
    )
    ax.set_title(
        title_text,
        fontsize=(COMPACT_TITLE_FONT_SIZE if compact else TITLE_FONT_SIZE),
        pad=8 if not compact else 2,
    )

    if canal_only or cord_only:
        if compact:
            ax.set_xlim(-1.00, 1.02)
        else:
            ax.set_xlim(-1.05, 4.20 if show_numbers else 1.05)
    elif compact:
        ax.set_xlim(-2.32, 1.28)
    else:
        # Extra room prevents population annotation text from touching the
        # colorbar.
        ax.set_xlim(-2.62, 5.05 if show_numbers else 1.70)

    ax.set_ylim(-0.64 if not compact else -0.62, 5.34)
    ax.set_aspect("equal")
    ax.axis("off")

    if add_colorbar:
        scalar_mappable = mpl.cm.ScalarMappable(norm=motion_norm, cmap=cmap)
        scalar_mappable.set_array([])
        if ax is not None and not compact and show_numbers:
            # Reserve a dedicated right margin for the standalone numerical
            # plots. This keeps the segment text clearly separated from the bar.
            fig.subplots_adjust(right=0.82)
            colorbar_axis = fig.add_axes([0.88, 0.18, 0.018, 0.64])
            colorbar = fig.colorbar(scalar_mappable, cax=colorbar_axis)
        else:
            colorbar = fig.colorbar(
                scalar_mappable, ax=ax, fraction=0.028,
                pad=0.020,
            )
        colorbar.ax.tick_params(labelsize=ANNOTATION_FONT_SIZE)
        colorbar.set_label(
            SIMULATION_COLORBAR_LABEL, fontsize=ANNOTATION_FONT_SIZE
        )

    if not compact and show_legend:
        draw_legend(
            ax,
            include_maximum_stenosis=(profile.maximum_level is not None),
        )

    if include_method_box:
        add_method_box(fig)
        fig.subplots_adjust(bottom=0.13)

    return fig, ax


