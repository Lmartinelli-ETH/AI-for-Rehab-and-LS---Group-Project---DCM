def _simulation_source_columns(spec):
    kind = str(spec.get("type", "column")).lower()
    if kind == "column":
        return [str(spec["column"])]
    if kind in {"ratio_to_min", "diff_to_min"}:
        return list(spec["sources"])
    if kind in {"signed_strain", "abs_strain", "interseg_diff"}:
        return [str(spec["current"]), str(spec["next"])]
    if kind == "curvature":
        return [str(spec[key]) for key in ("current", "lower", "upper")]
    if kind == "concentration":
        return list(spec["sources"])
    if kind in {"contrast", "abs_contrast"}:
        return [str(spec[key]) for key in ("numerator", "lower", "upper")
                if spec.get(key) is not None]
    if kind == "ratio":
        return [str(spec["numerator"]), str(spec["denominator"])]
    if kind in {"difference", "sum", "product"}:
        return [str(spec["left"]), str(spec["right"])]
    if kind == "expression":
        return re.findall(r"`([^`]+)`", str(spec["expression"]))
    raise ValueError(f"Unsupported simulation variable type: {kind!r}")


def build_simulation_variables(data):
    """Resolve all configured simulation formulas into internal columns."""
    data = data.copy()
    resolved = {}
    missing = sorted({
        col for spec in SIMULATION_VARIABLES.values()
        for col in _simulation_source_columns(spec)
        if col not in data.columns
    })
    if missing:
        raise KeyError("Missing SIMULATION_VARIABLES columns:\n" +
                       "\n".join(f"- {x}" for x in missing))

    for level, spec in SIMULATION_VARIABLES.items():
        kind = str(spec.get("type", "column")).lower()
        name = f"__simulation_{level}"
        if kind == "column":
            v = pd.to_numeric(data[str(spec["column"])], errors="coerce")
        elif kind == "ratio":
            a = pd.to_numeric(data[str(spec["numerator"])], errors="coerce")
            b = pd.to_numeric(data[str(spec["denominator"])], errors="coerce")
            v = a / b.replace(0, np.nan)
        elif kind in {"ratio_to_min", "diff_to_min"}:
            values = data[list(spec["sources"])].apply(pd.to_numeric, errors="coerce")
            minimum = values.min(axis=1, skipna=True)
            numerator = pd.to_numeric(data[str(spec["numerator"])], errors="coerce")
            v = (numerator / minimum.replace(0, np.nan)
                 if kind == "ratio_to_min" else numerator - minimum)
        elif kind in {"signed_strain", "abs_strain", "interseg_diff"}:
            current = pd.to_numeric(data[str(spec["current"])], errors="coerce")
            following = pd.to_numeric(data[str(spec["next"])], errors="coerce")
            difference = following - current
            if kind == "interseg_diff":
                v = difference
            elif kind == "signed_strain":
                v = difference / INTERSEGMENTAL_DISTANCE_MM
            else:
                v = difference.abs() / INTERSEGMENTAL_DISTANCE_MM
        elif kind == "curvature":
            current = pd.to_numeric(data[str(spec["current"])], errors="coerce")
            lower = pd.to_numeric(data[str(spec["lower"])], errors="coerce")
            upper = pd.to_numeric(data[str(spec["upper"])], errors="coerce")
            v = lower - 2 * current + upper
        elif kind == "concentration":
            values = data[list(spec["sources"])].apply(pd.to_numeric, errors="coerce")
            total = values.sum(axis=1, min_count=len(spec["sources"]))
            numerator = pd.to_numeric(data[str(spec["numerator"])], errors="coerce")
            v = numerator / total.replace(0, np.nan)
        elif kind in {"contrast", "abs_contrast"}:
            numerator = pd.to_numeric(data[str(spec["numerator"])], errors="coerce")
            lower = (pd.to_numeric(data[str(spec["lower"])], errors="coerce")
                     if spec["lower"] is not None else 0.0)
            upper = (pd.to_numeric(data[str(spec["upper"])], errors="coerce")
                     if spec["upper"] is not None else 0.0)
            denominator = lower - upper
            if kind == "abs_contrast":
                denominator = denominator.abs()
            v = numerator / denominator.replace(0, np.nan)
        elif kind in {"difference", "sum", "product"}:
            a = pd.to_numeric(data[str(spec["left"])], errors="coerce")
            b = pd.to_numeric(data[str(spec["right"])], errors="coerce")
            v = {"difference": a-b, "sum": a+b, "product": a*b}[kind]
        elif kind == "expression":
            tmp = data.copy()
            for col in _simulation_source_columns(spec):
                tmp[col] = pd.to_numeric(tmp[col], errors="coerce")
            v = tmp.eval(str(spec["expression"]), engine="python")
        else:
            raise ValueError(f"Unsupported simulation variable type: {kind!r}")
        data[name] = pd.to_numeric(v, errors="coerce").replace([np.inf, -np.inf], np.nan)
        resolved[str(level)] = name
    return data, resolved


@dataclass(frozen=True)
class ColumnMap:
    canal_ap: dict[str, str]
    cord_ap: dict[str, str]
    motion: dict[str, str]
    stenosis: dict[str, str]
    compression_side: dict[str, str]
    maximum_stenosis: Optional[str]

    @property
    def all_columns(self) -> list[str]:
        return list(
            dict.fromkeys(
                [
                    *self.canal_ap.values(),
                    *self.cord_ap.values(),
                    *self.motion.values(),
                    *self.stenosis.values(),
                    *self.compression_side.values(),
                    *([self.maximum_stenosis] if self.maximum_stenosis else []),
                ]
            )
        )

    @property
    def motion_required_columns(self) -> list[str]:
        return list(self.motion.values())

    @property
    def optional_anatomy_columns(self) -> list[str]:
        return list(
            dict.fromkeys(
                [
                    *self.canal_ap.values(),
                    *self.cord_ap.values(),
                    *self.stenosis.values(),
                    *self.compression_side.values(),
                    *([self.maximum_stenosis] if self.maximum_stenosis else []),
                ]
            )
        )


