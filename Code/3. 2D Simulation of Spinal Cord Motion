@dataclass(frozen=True)
class SimulationConfig:
    mode: str
    title: str
    colorbar_label: str
    labels: tuple[str, ...]
    y: np.ndarray
    specifications: dict[str, dict[str, object]]

def _template_values(index: int) -> dict[str, str]:
    """All supported placeholders for one study measurement position."""
    return {
        "level": LEVELS[index],
        "level_lower": LEVELS[index].lower(),
        "segment_db": SEGMENTS2[index],
        "segment": MEASUREMENT_SEGMENTS[index],
    }

def format_simulation_column(template: str, index: int) -> str:
    """Format a database-column template with all supported placeholders."""
    try:
        return str(template).format(**_template_values(index))
    except KeyError as exc:
        supported = "{level}, {level_lower}, {segment_db}, {segment}"
        raise ValueError(
            f"Unknown placeholder {exc!s} in simulation column template "
            f"{template!r}. Supported placeholders: {supported}."
        ) from exc

def resolve_simulation_config(
    requested_mode: Optional[str] = None,
) -> SimulationConfig:
    mode = str(
        SIMULATION_MODE if requested_mode is None else requested_mode
    ).strip().lower()

    if mode not in ALL_SIMULATION_MODES:
        raise ValueError(f"Unknown simulation mode {mode!r}. Choose from {ALL_SIMULATION_MODES}.")

    template = str(MODE_RAW["column_template"])
    source = [format_simulation_column(template, i) for i in range(len(LEVELS))]
    specs = {}
    labels = []
    positions = []

    for i, level in enumerate(LEVELS):
        if mode == "raw":
            spec = {"type": "column", "column": source[i]}
        elif mode == "ratio_to_c2":
            ref = str(MODE_RATIO_TO_C2["reference_level"])
            spec = {"type": "ratio", "numerator": source[i],
                    "denominator": source[LEVELS.index(ref)]}
        elif mode in {"ratio_to_min", "diff_to_min"}:
            spec = {"type": mode, "numerator": source[i], "sources": source}
        elif mode == "gradient_down":
            if i == len(LEVELS) - 1:
                continue  # no inferior measurement for C7
            spec = {"type": "ratio", "numerator": source[i],
                    "denominator": source[i + 1]}
        elif mode == "gradient_up":
            if i == 0:
                continue  # no superior measurement for C2
            spec = {"type": "ratio", "numerator": source[i],
                    "denominator": source[i - 1]}
        elif mode in {"signed_strain", "abs_strain", "interseg_diff"}:
            if i == len(LEVELS) - 1:
                continue  # no next caudal measurement
            spec = {"type": mode, "current": source[i], "next": source[i + 1]}
        elif mode == "curvature":
            if i == 0 or i == len(LEVELS) - 1:
                continue  # centered second difference requires two neighbors
            spec = {"type": mode, "current": source[i],
                    "lower": source[i + 1], "upper": source[i - 1]}
        elif mode == "concentration":
            spec = {"type": mode, "numerator": source[i], "sources": source}
        elif mode in {"contrast", "abs_contrast"}:
            # Boundary values outside C2...C7 are defined as zero.
            # C2: C2 / (C3 - 0); C7: C7 / (0 - C6).
            spec = {"type": mode, "numerator": source[i],
                    "lower": source[i + 1] if i + 1 < len(LEVELS) else None,
                    "upper": source[i - 1] if i > 0 else None}
        specs[MEASUREMENT_SEGMENTS[i]] = spec
        labels.append(level)
        positions.append(MEASUREMENT_Y[i])

    titles = {
        "raw": "Raw motion amplitude",
        "ratio_to_c2": "Ratio to C2",
        "ratio_to_min": "Ratio to minimum",
        "diff_to_min": "Difference to minimum",
        "gradient_down": "Gradient down",
        "gradient_up": "Gradient up",
        "contrast": "Contrast",
        "abs_contrast": "Absolute contrast",
        "signed_strain": "Signed strain",
        "abs_strain": "Absolute strain",
        "interseg_diff": "Intersegmental difference",
        "curvature": "Curvature",
        "concentration": "Concentration",
    }
    return SimulationConfig(
        mode=mode, title=titles[mode], colorbar_label=titles[mode],
        labels=tuple(labels), y=np.array(positions, dtype=float),
        specifications=specs,
    )


def activate_simulation_mode(mode: str) -> SimulationConfig:
    """Activate exactly one concrete simulation mode for downstream functions."""
    global SIMULATION_CONFIG
    global SIMULATION_TITLE
    global SIMULATION_COLORBAR_LABEL
    global SIMULATION_VARIABLES
    global SIMULATION_Y
    global SIMULATION_VALUE_LABELS

    config = resolve_simulation_config(mode)
    SIMULATION_CONFIG = config
    SIMULATION_TITLE = config.title
    SIMULATION_COLORBAR_LABEL = config.colorbar_label
    SIMULATION_VARIABLES = config.specifications
    SIMULATION_Y = config.y
    SIMULATION_VALUE_LABELS = config.labels
    return config


