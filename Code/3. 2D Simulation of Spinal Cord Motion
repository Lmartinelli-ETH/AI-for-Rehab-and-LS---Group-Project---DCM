def draw_posterior_element(
    ax: Axes,
    geometry: DenseGeometry,
    y_center: float,
    compact: bool,
) -> None:
    canal_x = (
        x_at(
            y_center,
            geometry.y,
            geometry.canal_right,
        )
        + POSTERIOR_LIGAMENT_GAP
    )

    process_length = 0.82 if not compact else 0.66

    canal_reference = float(np.median(geometry.canal_right))
    local_curve = np.clip(
        (canal_x - canal_reference) * 0.12,
        -0.025,
        0.025,
    )
    outer_x = canal_x + process_length + local_curve

    posterior_tip_y = y_center - 0.38

    anterior_top_y = y_center + 0.30
    anterior_mid_y = y_center + 0.06
    anterior_bottom_y = y_center - 0.24

    vertices = [
        (canal_x + 0.015, anterior_top_y),
        (canal_x + 0.13, anterior_top_y + 0.01),
        (canal_x + 0.29, y_center + 0.25),
        (canal_x + 0.39, y_center + 0.16),
        (canal_x + 0.50, y_center + 0.10),
        (outer_x - 0.13, y_center + 0.04),
        (outer_x - 0.035, posterior_tip_y + 0.11),
        (outer_x + 0.025, posterior_tip_y + 0.045),
        (outer_x + 0.005, posterior_tip_y - 0.025),
        (outer_x - 0.085, posterior_tip_y - 0.055),
        (outer_x - 0.20, posterior_tip_y - 0.065),
        (canal_x + 0.40, anterior_bottom_y - 0.045),
        (canal_x + 0.22, anterior_bottom_y),
        (canal_x + 0.10, anterior_bottom_y + 0.01),
        (canal_x + 0.020, y_center - 0.13),
        (canal_x + 0.015, anterior_mid_y),
        (canal_x + 0.015, y_center + 0.16),
        (canal_x + 0.015, y_center + 0.25),
        (canal_x + 0.015, anterior_top_y),
        (canal_x + 0.015, anterior_top_y),
    ]

    codes = [
        MplPath.MOVETO,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CURVE4,
        MplPath.CLOSEPOLY,
    ]

    ax.add_patch(
        PathPatch(
            MplPath(vertices, codes),
            facecolor="#efe7d8",
