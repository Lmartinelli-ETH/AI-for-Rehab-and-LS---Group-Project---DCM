# LOAD DATA
# =============================================================================

data = pd.read_excel(
    INPUT_FILE,
    sheet_name=INPUT_SHEET,
)

original_columns = list(data.columns)


# =============================================================================
# PASS 1
# NORMALIZE EXISTING SUFFIXES + REMOVE DUPLICATES
# =============================================================================

columns = []

print('\n' + '=' * 100)
print('PASS 1: NORMALIZE EXISTING TIMEPOINT ENDINGS')
print('=' * 100)


for column in original_columns:

    # -------------------------------------------------------------------------
    # Rule:
    # empty / unnamed -> NEVER modify
    # -------------------------------------------------------------------------

    if is_empty_or_unnamed(column):

        columns.append(column)

        continue


    # -------------------------------------------------------------------------
    # Clean existing suffix
    # -------------------------------------------------------------------------

    cleaned = clean_existing_suffix(column)


    # -------------------------------------------------------------------------
    # Print every actual change
    # -------------------------------------------------------------------------

    if cleaned != column:

        print('\nCHANGED:')

        print(f'  OLD: {column}')
        print(f'  NEW: {cleaned}')


    columns.append(cleaned)


# =============================================================================
# FIX SPECIFIC KNOWN VARIABLE NAMES
# =============================================================================

SPECIFIC_RENAMES = {

    'c4_5_peak_v_downwards_corr_all_mean_v2_BL':
        'c4_5_peak_downwards_corr_all_mean_v2_BL',

    # Standardize AUC corrallmean variable names
    'C2_AUC_corrallmean_mm_BL': 'c2_auc_corrallmean_mm_BL',
    'C3_AUC_corallmean_mm_BL': 'c3_auc_corrallmean_mm_BL',
    'C4_AUC_corallmean_mm_BL': 'c4_auc_corrallmean_mm_BL',
    'C5_auc_corallmean_mm_BL': 'c5_auc_corrallmean_mm_BL',
    'C6_auc_corallmean_mm_BL': 'c6_auc_corrallmean_mm_BL',
    'C7_auc_corallmean_mm_BL': 'c7_auc_corrallmean_mm_BL',

}

for i, column in enumerate(columns):

    if column in SPECIFIC_RENAMES:

        new_column = SPECIFIC_RENAMES[column]

        print('\nSPECIFIC VARIABLE NAME FIX:')

        print(f'  OLD: {column}')
        print(f'  NEW: {new_column}')

        columns[i] = new_column


# =============================================================================
# PASS 2
# ADD MISSING SUFFIX BASED ON LEFT + RIGHT NEIGHBOUR
# =============================================================================

print('\n' + '=' * 100)
print('PASS 2: CHECK COLUMNS WITHOUT TIMEPOINT ENDING')
print('=' * 100)


new_columns = columns.copy()


for i, column in enumerate(columns):

    # =========================================================================
    # RULE 6:
    # Empty / unnamed columns stay completely untouched
    # =========================================================================

    if is_empty_or_unnamed(column):
        continue


    # =========================================================================
    # PROTECTED VARIABLES
    #
    # Never infer / append a timepoint for:
    #
    #   ..._selection
    #
    # or:
    #
    #   ..._12mth_or_6mth
    #   ..._36mth_or_24mth
    #   ..._12mth_or_BL
    #   etc.
    # =========================================================================

    if re.search(r'_perc_max$', str(column), flags=re.IGNORECASE):
        continue

    if is_protected_column(column):

        print('\nPROTECTED VARIABLE - NO TIMEPOINT ADDED:')
        print(f'  FIELD: {column}')

        continue


    # =========================================================================
    # Already has a valid normal timepoint
    # =========================================================================

    if get_timepoint_suffix(column) is not None:
        continue


    # =========================================================================
    # First / last column:
    # cannot compare TWO neighbours
    # =========================================================================

    if i == 0 or i == len(columns) - 1:

        print(
            '\nMISSING TIMEPOINT - '
            'CANNOT DETERMINE FROM TWO NEIGHBOURS'
        )

        print(f'  FIELD: {column}')


        if i > 0:
            print(f'  Left : {columns[i - 1]}')


        if i < len(columns) - 1:
            print(f'  Right: {columns[i + 1]}')


        continue


    # =========================================================================
    # Get neighbours
    # =========================================================================

    left_column = columns[i - 1]
    right_column = columns[i + 1]


    left_suffix = get_timepoint_suffix(left_column)
    right_suffix = get_timepoint_suffix(right_column)


    # =========================================================================
    # Both neighbours have SAME valid normal timepoint
    # =========================================================================

    if (
        left_suffix is not None
        and right_suffix is not None
        and left_suffix == right_suffix
    ):

        new_column = f'{column}{left_suffix}'


        print('\nADDING TIMEPOINT FROM NEIGHBOURS:')

        print(f'  Left : {left_column}')
        print(f'  OLD  : {column}')
        print(f'  Right: {right_column}')

        print(f'  NEW  : {new_column}')


        new_columns[i] = new_column


    # =========================================================================
    # Neighbours do not agree
    # =========================================================================

    else:

        print('\nMISSING / AMBIGUOUS TIMEPOINT - NO CHANGE:')

        print(f'  Left : {left_column}')
        print(f'  FIELD: {column}')
        print(f'  Right: {right_column}')

        print(
            '  Detected suffixes: '
            f'left={left_suffix}, '
            f'right={right_suffix}'
        )


# =============================================================================
# APPLY CLEANED COLUMN NAMES
# =============================================================================

data.columns = new_columns


# =============================================================================
# SUMMARY
# =============================================================================

print('\n' + '=' * 100)
print('SUMMARY')
print('=' * 100)


changes = 0


for old, new in zip(original_columns, new_columns):

    if old != new:

        changes += 1

        print(f'{old}  ->  {new}')


print('\nColumns in data        :', len(data.columns))
print('Columns in new_columns :', len(new_columns))
print('Changed columns        :', changes)


