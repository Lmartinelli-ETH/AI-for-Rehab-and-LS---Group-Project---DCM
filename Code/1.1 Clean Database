# Gültige / kanonische Timepoints
TIMEPOINTS = (
    '_BL',
    '_6mth',
    '_12mth',
    '_24mth',
    '_36mth',
    '_48mth',
    '_60mth',
)

TIMEPOINT_VALUES = (
    'BL',
    '6mth',
    '12mth',
    '24mth',
    '36mth',
    '48mth',
    '60mth',
)


# =============================================================================
# HELPER FUNCTIONS
# =============================================================================

def remove_dot_number_suffix(column_name):
    if is_empty_or_unnamed(column_name):
        return column_name

    return re.sub(r'\.\d+$', '', str(column_name))


def normalize_perc_max(column_name):
    if is_empty_or_unnamed(column_name):
        return column_name

    column_name = str(column_name)

    if not re.search(r'_perc_max$', column_name, flags=re.IGNORECASE):
        return column_name

    base = re.sub(r'_perc_max$', '', column_name, flags=re.IGNORECASE)
    tp_pattern = r'(?:BL|6mth|12mth|24mth|36mth|48mth|60mth)'
    timepoints = re.findall(
        rf'_(?P<tp>{tp_pattern})(?=_|$)',
        base,
        flags=re.IGNORECASE,
    )

    if not timepoints:
        return column_name

    base = re.sub(
        rf'_(?:{tp_pattern})(?=_|$)',
        '',
        base,
        flags=re.IGNORECASE,
    )

    suffixes = []
    seen = set()

    for timepoint in timepoints:
        if timepoint.lower() not in seen:
            seen.add(timepoint.lower())
            suffixes.append(canonical_suffix(timepoint))

    return f"{base}_perc_max{''.join(suffixes)}"


def is_empty_or_unnamed(column_name):
    """
    True für leere oder von pandas als 'Unnamed' erkannte Spalten.

    Beispiele:
        None
        ''
        '   '
        'Unnamed: 25'
    """

    if column_name is None:
        return True

    column_name = str(column_name).strip()

    if not column_name:
        return True

    return column_name.lower().startswith('unnamed:')


def ends_with_selection(column_name):
    """
    Prüft, ob die Variable auf '_selection' endet.

    Solche Variablen werden grundsätzlich geschützt:
    Es darf KEIN zusätzlicher Timepoint angehängt werden.
    """

    if is_empty_or_unnamed(column_name):
        return False

    return bool(
        re.search(
            r'_selection$',
            str(column_name),
            flags=re.IGNORECASE,
        )
    )


def has_or_timepoint_expression(column_name):
    """
    Erkennt kombinierte Timepoint-Ausdrücke mit '_or_'.

    Beispiele:
        x_6mth_or_12mth
        x_36mth_or_24mth
        x_12mth_or_BL
        x_12mth_or_bl
        x_12mth_or_6mth_selection
        x_12mth_or_6mth_bl

    Sobald ein solcher Timepoint-Ausdruck vorhanden ist,
    wird die Variable von der normalen Timepoint-Logik ausgeschlossen.
    """

    if is_empty_or_unnamed(column_name):
        return False

    tp = r'(?:BL|6mth|12mth|24mth|36mth|48mth|60mth)'

    pattern = rf'_{tp}_or_{tp}'

    return bool(
        re.search(
            pattern,
            str(column_name),
            flags=re.IGNORECASE,
        )
    )


def normalize_or_bl(column_name):
    """
    Sonderregel für kombinierte Timepoint-Ausdrücke:

        _or_bl  -> _or_BL

    Beispiel:
        x_12mth_or_bl
            ->
        x_12mth_or_BL

    WICHTIG:
        Ein normales abschließendes '_bl' wird bei geschützten
        OR-Ausdrücken NICHT verändert.

    Beispiel:
        x_12mth_or_6mth_bl
            bleibt
        x_12mth_or_6mth_bl
    """

    if is_empty_or_unnamed(column_name):
        return column_name

    return re.sub(
        r'_or_bl(?=$|_selection$)',
        '_or_BL',
        str(column_name),
        flags=re.IGNORECASE,
    )


def is_protected_column(column_name):
    """
    Prüft, ob eine Spalte von der normalen Timepoint-Bereinigung
    ausgeschlossen werden soll.

    Geschützt sind:

    1. Variablen mit '_or_' zwischen Timepoints
    2. Variablen, die auf '_selection' enden
    """

    return (
        ends_with_selection(column_name)
        or has_or_timepoint_expression(column_name)
    )


def normalize_simple_timepoint_suffix(column_name):
    """
    Normalisiert den Timepoint am ENDE einer normalen Variable.

    Beispiele:
        variable_bl
            -> variable_BL

        variable_Bl
            -> variable_BL

        variable_48MTH
            -> variable_48mth

        variable_12Mth
            -> variable_12mth


    WICHTIG:
    Geschützte '_or_'- und '_selection'-Variablen werden hier
    NICHT verändert.
    """

    if is_empty_or_unnamed(column_name):
        return column_name

    column_name = str(column_name)

    if is_protected_column(column_name):
        return column_name

    # Baseline normalisieren
    column_name = re.sub(
        r'_bl$',
        '_BL',
        column_name,
        flags=re.IGNORECASE,
    )

    # Follow-up-Timepoints normalisieren
    column_name = re.sub(
        r'_(6|12|24|36|48|60)mth$',
        lambda match: f'_{match.group(1)}mth',
        column_name,
        flags=re.IGNORECASE,
    )

    return column_name


def canonical_suffix(timepoint):
    """
    Gibt die kanonische Schreibweise eines Timepoints zurück.
    """

    if timepoint.lower() == 'bl':
        return '_BL'

    return f'_{timepoint.lower()}'


def remove_duplicate_timepoint_suffix(column_name):
    """
    Entfernt doppelte identische Timepoint-Endungen.

    Beispiele:
        x_24mth_24mth
            -> x_24mth

        x_24MTH_24mth
            -> x_24mth

        x_BL_BL
            -> x_BL

        x_bl_BL
            -> x_BL

        x_48mth_48MTH
            -> x_48mth

    Auch mehrfache Wiederholungen werden reduziert:

        x_24mth_24mth_24mth
            -> x_24mth

    Geschützte OR-/selection-Variablen werden NICHT verändert.
    """

    if is_empty_or_unnamed(column_name):
        return column_name

    column_name = str(column_name)

    if is_protected_column(column_name):
        return column_name

    tp_pattern = r'(BL|6mth|12mth|24mth|36mth|48mth|60mth)'

    while True:

        match = re.search(
            rf'_(?P<tp1>{tp_pattern})_(?P<tp2>{tp_pattern})$',
            column_name,
            flags=re.IGNORECASE,
        )

        if not match:
            break

        tp1 = match.group('tp1')
        tp2 = match.group('tp2')

        # Nur identische doppelte Timepoints entfernen
        if tp1.lower() != tp2.lower():
            break

        suffix = canonical_suffix(tp1)

        column_name = (
            column_name[:match.start()]
            + suffix
        )

    return column_name


def clean_existing_suffix(column_name):
    """
    Bereinigt bereits vorhandene Endungen.

    Reihenfolge:

    1. leere / unnamed Spalten nicht verändern
    2. OR-Sonderfall '_or_bl' -> '_or_BL'
    3. geschützte Variablen danach nicht weiter bearbeiten
    4. normale Timepoint-Endungen normalisieren
    5. doppelte Endungen entfernen
    """

    if is_empty_or_unnamed(column_name):
        return column_name

    column_name = str(column_name)

    column_name = remove_dot_number_suffix(column_name)
    column_name = normalize_perc_max(column_name)

    # -------------------------------------------------------------------------
    # Sonderregel für OR-Konstruktionen
    # -------------------------------------------------------------------------

    column_name = normalize_or_bl(column_name)

    # -------------------------------------------------------------------------
    # OR- und selection-Spalten danach NICHT weiter verändern
    # -------------------------------------------------------------------------

    if is_protected_column(column_name):
        return column_name

    # -------------------------------------------------------------------------
    # Normale Timepoint-Spalten
    # -------------------------------------------------------------------------

    previous = None

    while previous != column_name:

        previous = column_name

        column_name = normalize_simple_timepoint_suffix(column_name)

        column_name = remove_duplicate_timepoint_suffix(column_name)

        # Nach Entfernen einer doppelten Endung erneut normalisieren
        column_name = normalize_simple_timepoint_suffix(column_name)

    return column_name


def get_timepoint_suffix(column_name):
    """
    Gibt bei einer normalen Variable den kanonischen Timepoint zurück.

    Beispiele:
        abc_BL
            -> '_BL'

        abc_24mth
            -> '_24mth'

        abc
            -> None


    Geschützte Variablen liefern IMMER None.

    Beispiele:
        abc_12mth_or_6mth
            -> None

        abc_12mth_or_6mth_selection
            -> None
    """

    if is_empty_or_unnamed(column_name):
        return None

    column_name = str(column_name)

    if is_protected_column(column_name):
        return None

    column_name = normalize_simple_timepoint_suffix(column_name)

    for suffix in TIMEPOINTS:

        if column_name.endswith(suffix):
            return suffix

    return None


