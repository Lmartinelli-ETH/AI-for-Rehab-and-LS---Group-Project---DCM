def results(features):
    if isinstance(features, str):
        features = [features]
    selected_results = []
    for row in range(len(file)):
        row_results = []
        for feature in features:
            row_results.extend(ALL_FEATURES[feature][row])
        selected_results.append(tuple(row_results))
    return selected_results

# DataFrame
def df_results(features):
    if isinstance(features, str):
        features = [features]
    feature_names = []
    for feature in features:
        feature_names.extend(ALL_FEATURE_NAMES[feature])
    df_result = pd.DataFrame(results(features), columns=feature_names)
    df_result = df_result.loc[:, ~df_result.columns.duplicated()]
    if 'record_id_BL' in df_result.columns:
        df_result = df_result.set_index('record_id_BL')
    print(df_result)
    return df_result

#####################################################################################################################################################
################################################################# Create Database ###################################################################
#####################################################################################################################################################
def duplicate_database(data):
    if os.path.exists(PATH_OUT):
        wb = load_workbook(PATH_OUT)

        if "database" in wb.sheetnames:
            print("Sheet 'database' already exists. Creation is skipped.")
            wb.close()
            return

        wb.close()

        # File exists but Sheet 'database' is missing
        with pd.ExcelWriter(PATH_OUT, engine="openpyxl", mode="a") as writer:
            data.to_excel(writer, sheet_name="database", index=False)

    else:
        # File does not exist yet
        data.to_excel(PATH_OUT, sheet_name="database", index=False)

#####################################################################################################################################################
################################################################### Create Sheet ####################################################################
#####################################################################################################################################################
def create_sheet(df_result, sheet_name):
    mode = "a" if os.path.exists(PATH_OUT) else "w"
    writer_settings = {
        'path': PATH_OUT,
        'engine': "openpyxl",
        'mode': mode,
    }
    if mode == "a":
        writer_settings['if_sheet_exists'] = "replace"

    with pd.ExcelWriter(**writer_settings) as writer:
        df_result.to_excel(writer, sheet_name=sheet_name)

        #####################################################################################################################################################
        ################################################################### Color Columns ###################################################################
        #####################################################################################################################################################
        # Define Colors
        fill_not = PatternFill(fill_type='solid', start_color="FFFFFFFF", end_color="FFFFFFFF")     # white
        fill_adj = PatternFill(fill_type="solid", start_color="FFF76F", end_color="FFF76F")         # light yellow
        fill_hf = PatternFill(fill_type="solid", start_color="DAF2D0", end_color="DAF2D0")           # light green
        fill_motion = PatternFill(fill_type="solid", start_color="c4eaeb", end_color="c4eaeb")      # light blue
        fill_important = PatternFill(fill_type="solid", start_color="F7C7AC", end_color="F7C7AC")   # orange

        # Direct access to the new sheet
        sheet = writer.sheets[sheet_name]

        # Run through Header-Rows
        for col_idx, cell in enumerate(sheet[1], start=1):
            col_name = cell.value

            if col_name is not None and ("adj" in str(col_name)):
                fill = fill_adj
            elif col_name == 'maximum_stenosis_BL' or col_name == 'substudy___1_BL' or col_name == "number_stenosis_BL":   # baseline values --> used for futher investigation
                fill = fill_important
            elif col_name is not None and (("_amp_" in str(col_name)) or ("_disp_" in str(col_name))):
                fill = fill_motion
            elif col_name is not None and ("_hf_" in str(col_name)):
                fill = fill_hf
            else:
                fill = fill_not

            # Coloring whole columns
            for row in range(1, sheet.max_row + 1):
                sheet.cell(row=row, column=col_idx).fill = fill


