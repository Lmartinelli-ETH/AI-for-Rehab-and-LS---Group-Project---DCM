def expand_timepoints(columns):
    """Erweitert _BL-Variablen auf alle drei Zeitpunkte."""
    expanded = []

    for col in columns:
        if col.endswith("_BL"):
            base = col[:-3]
            expanded.extend(
                f"{base}_{timepoint}"
                for timepoint in TIMEPOINTS
            )
        else:
            expanded.append(col)

    return list(dict.fromkeys(expanded))


