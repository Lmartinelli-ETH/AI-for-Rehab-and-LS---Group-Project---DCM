def normalize_excel_header(name):
    """
    Excel-Spaltennamen robust vereinheitlichen.

    Entfernt insbesondere unsichtbare / versehentliche Leerzeichen,
    Zeilenumbrüche und Non-Breaking Spaces, die in Excel-Headern
    vorkommen können. Die eigentlichen Variablennamen werden nicht
    verändert.
    """

    return (
        str(name)
        .replace("\xa0", " ")
        .replace("\u200b", "")
        .replace("\r", " ")
        .replace("\n", " ")
        .replace("\t", " ")
        .strip()
    )


def clean_sheet_columns(sheet_df):
    """Bereinigt nur die Excel-Header, nicht die Daten selbst."""

    sheet_df = sheet_df.copy()
    sheet_df.columns = [
        normalize_excel_header(col)
        for col in sheet_df.columns
    ]

    return sheet_df


