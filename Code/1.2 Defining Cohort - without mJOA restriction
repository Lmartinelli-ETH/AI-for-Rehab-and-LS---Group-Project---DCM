def resolve_column_in_workbook(requested_col):
    """
    Sucht eine Variable in allen Sheets.

    Rückgabe:
        (sheet_name, actual_column_name)
    oder
        (None, None)
    """

    requested_key = normalize_excel_header(
        requested_col
    ).casefold()

    for sheet_name in source_sheet_order:

        sheet_df = all_sheets_lookup[sheet_name]

        column_map = {
            normalize_excel_header(col).casefold(): col
            for col in sheet_df.columns
        }

        if requested_key in column_map:

            actual_col = column_map[requested_key]

            # Für das spätere Mapping brauchen wir record_id_BL
            # im selben Sheet.
            id_map = {
                normalize_excel_header(col).casefold(): col
                for col in sheet_df.columns
            }

            id_key = normalize_excel_header(id_col).casefold()

            if id_key in id_map:
                return (
                    sheet_name,
                    actual_col,
                    id_map[id_key],
                )

    return None, None, None


