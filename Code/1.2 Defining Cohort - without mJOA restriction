def clean_var_name(var):

    return (
        var
        .replace("_BL", "")
        .replace("_", " ")
    )


def format_missing_details(
    missing_by_variable
):

    lines = []

    for var, n_missing in (
        missing_by_variable.items()
    ):

        if n_missing > 0:

            lines.append(
                f"• {clean_var_name(var)}: "
                f"n = {n_missing}"
            )

    return lines


def wrap_text(
    text,
    width=34
):
    """
    Bricht Text sauber um. Bereits vorhandene Zeilenumbrüche
    werden beibehalten.
    """

    wrapped_lines = []

    for line in str(text).split("\n"):

        if line.strip() == "":
            wrapped_lines.append("")

        else:
            wrapped_lines.extend(
                textwrap.wrap(
                    line,
                    width=width,
                    break_long_words=False,
                    break_on_hyphens=False,
                    replace_whitespace=False
                )
            )

    return "\n".join(wrapped_lines)


def count_text_lines(text):
    """Anzahl der tatsächlich zu zeichnenden Textzeilen."""

    return max(
        1,
        len(str(text).split("\n"))
    )


def text_block_height_pt(
    text,
    fontsize,
    linespacing
):
    """
    Robuste Textblock-Höhe in Punkten.

    Wichtig: Hier wird absichtlich nicht die temporäre Matplotlib-
    Bounding-Box verwendet. Deren Höhe kann sich nach
    subplots_adjust / bbox_inches='tight' verändern und führte zuvor
    dazu, dass die letzte Textzeile aus einzelnen Boxen herausragte.

    Die Zeilenhöhe wird direkt aus Schriftgrösse und line spacing
    bestimmt. Ein kleiner Descent-Sicherheitszuschlag sorgt dafür,
    dass Zeichen wie g, p, y usw. sicher innerhalb der Box bleiben.
    """

    n_lines = count_text_lines(text)

    line_height_pt = (
        fontsize
        * linespacing
    )

    descent_safety_pt = fontsize * 0.18

    return (
        n_lines * line_height_pt
        + descent_safety_pt
    )


def box_height_pt(
    text,
    fontsize,
    linespacing,
    padding_pt=BOX_PADDING_PT
):
    """
    Boxhöhe in Punkten:
    Texthöhe + gleicher Innenabstand oben und unten.
    """

    return (
        text_block_height_pt(
            text=text,
            fontsize=fontsize,
            linespacing=linespacing
        )
        + 2 * padding_pt
    )


def pt_to_axes_x(ax, points):
    """Punkte -> x-Achsenkoordinaten."""

    pixels = points * ax.figure.dpi / 72
    return pixels / ax.bbox.width


def pt_to_axes_y(ax, points):
    """Punkte -> y-Achsenkoordinaten."""

    pixels = points * ax.figure.dpi / 72
    return pixels / ax.bbox.height


def draw_rect_box(
    ax,
    x,
    y,
    w,
    h,
    text,
    fontsize=MAIN_FONT_SIZE,
    lw=1.6,
    ha="center",
    facecolor="white",
    linespacing=LEFT_LINE_SPACING
):

    rect = Rectangle(
        (x, y),
        w,
        h,
        facecolor=facecolor,
        edgecolor="black",
        linewidth=lw
    )

    ax.add_patch(rect)

    pad_x = pt_to_axes_x(
        ax,
        BOX_PADDING_PT
    )

    if ha == "left":
        text_x = x + pad_x

    elif ha == "right":
        text_x = x + w - pad_x

    else:
        text_x = x + w / 2

    ax.text(
        text_x,
        y + h / 2 - 0.0025,
        text,
        ha=ha,
        va="center",
        fontsize=fontsize,
        linespacing=linespacing,
        fontfamily=FONT_FAMILY,
        clip_on=False
    )


def draw_exclusion_box(
    ax,
    x,
    y,
    w,
    h,
    text,
    lw=1.4,
    fontsize=DETAIL_FONT_SIZE,
    linespacing=RIGHT_LINE_SPACING
):

    rect = Rectangle(
        (x, y-0.01),
        w,
        h+0.02,
        facecolor="white",
        edgecolor="black",
        linewidth=lw
    )

    ax.add_patch(rect)

    pad_x = pt_to_axes_x(
        ax,
        BOX_PADDING_PT
    )

    pad_y = pt_to_axes_y(
        ax,
        BOX_PADDING_PT,
    )

    ax.text(
        x + pad_x,
        y + h+0.005 - pad_y,
        text,
        ha="left",
        va="top",
        fontsize=fontsize,
        linespacing=linespacing,
        fontfamily=FONT_FAMILY,
        clip_on=False
    )


def draw_arrow(
    ax,
    x1,
    y1,
    x2,
    y2,
    lw=1.2,
    mutation_scale=13
):

    arrow = FancyArrowPatch(
        (x1, y1),
        (x2, y2),
        arrowstyle="-|>",
        mutation_scale=mutation_scale,
        linewidth=lw,
        color="black",
        shrinkA=0,
        shrinkB=0
    )

    ax.add_patch(arrow)


# ============================================================
# 11. STROBE-Diagramm erstellen
# ============================================================

# Alle drei Filterschritte zeichnen, auch wenn in einem Schritt n = 0
# ausgeschlossen werden. Dadurch bleiben immer genau vier linke Boxen:
# Complete data -> MRI -> Spinal Cord Motion -> Clinical Variables.
flow_rows_plot = flow_rows.copy()


# ============================================================
# Texte vollständig vorbereiten
# ============================================================

start_text = (
    "Initial study population\n"
    f"n = {n_initial}"
)

final_text = (
    "Final study population\n"
    f"n = {n_final}"
)

for row in flow_rows_plot:

    if row["group"] == "MRI":

        left_text = (
            "MRI measurements done and complete "
            "MRI findings / scores\n"
            f"n = {row['n_after']}"
        )

    elif row["group"] == "Spinal Cord Motion":

        left_text = (
            "Cohort after exclusion of patients "
            "with missing Spinal Cord Motion data\n"
            f"n = {row['n_after']}"
        )

    elif row["group"] == "mJOA Restriction":

        left_text = final_text

    else:

        left_text = (
            "Cohort after exclusion of patients "
            f"with missing {row['group']}\n"
            f"n = {row['n_after']}"
        )

    row["left_text"] = wrap_text(
        left_text,
        width=LEFT_WRAP_WIDTH
    )


    if row["group"] == "MRI":
        title = wrap_text(
            "Excluded due to MRI criteria:",
            width=RIGHT_TITLE_WRAP_WIDTH
        )
    elif row["group"] == "mJOA Restriction":
        title = wrap_text(
            "Excluded due to mJOA restriction:",
            width=RIGHT_TITLE_WRAP_WIDTH
        )
    else:
        title = wrap_text(
            f"Excluded due to missing {row['group']}:",
            width=RIGHT_TITLE_WRAP_WIDTH
        )

    details = format_missing_details(
        row["missing_by_subgroup"]
    )

    detail_text = "\n".join(
        wrap_text(
            line,
            width=RIGHT_DETAIL_WRAP_WIDTH
        )
        for line in details
    )

    row["right_text"] = (
        title
    )

    if detail_text.strip():
        row["right_text"] += "\n" + detail_text



# ============================================================
# Grössen zunächst vollständig in Punkten bestimmen
# ============================================================

start_h_pt = box_height_pt(
    text=start_text,
    fontsize=MAIN_FONT_SIZE,
    linespacing=LEFT_LINE_SPACING
)

for row in flow_rows_plot:

    row["left_h_pt"] = box_height_pt(
        text=row["left_text"],
        fontsize=MAIN_FONT_SIZE,
        linespacing=LEFT_LINE_SPACING
    )

    row["right_h_pt"] = box_height_pt(
        text=row["right_text"],
        fontsize=DETAIL_FONT_SIZE,
        linespacing=RIGHT_LINE_SPACING
    )

    # Der Abstand zwischen zwei linken Boxen wird durch die Höhe der
    # rechten Box bestimmt. Damit liegt die rechte Box vollständig und
    # mittig im Zwischenraum und die horizontale Pfeillinie trifft
    # exakt ihre vertikale Mitte.
    row["gap_pt"] = max(
        MIN_GAP_PT,
        row["right_h_pt"]
        + 2 * RIGHT_BOX_CLEARANCE_PT
    )


# ============================================================
# Figure-Höhe aus Inhalt ableiten
# ============================================================

FIG_WIDTH = 13.0

TOP_MARGIN_PT = 18
BOTTOM_MARGIN_PT = 18

content_height_pt = (
    TOP_MARGIN_PT
    + start_h_pt
    + sum(row["gap_pt"] for row in flow_rows_plot)
    + sum(row["left_h_pt"] for row in flow_rows_plot)
    + BOTTOM_MARGIN_PT
)

# Punkte -> Inch; etwas Reserve verhindert, dass bbox_inches='tight'
# die äusseren Konturen optisch zu knapp beschneidet.
# ============================================================
# Figure-Höhe aus Inhalt ableiten
# ============================================================

FIG_WIDTH = 13.0

TOP_MARGIN_PT = 18
BOTTOM_MARGIN_PT = 28

content_height_pt = (
    TOP_MARGIN_PT
    + start_h_pt
    + sum(row["gap_pt"] for row in flow_rows_plot)
    + sum(row["left_h_pt"] for row in flow_rows_plot)
    + BOTTOM_MARGIN_PT
)


# Tatsächlich nutzbarer vertikaler Anteil der Figure
AXES_TOP = 0.985
AXES_BOTTOM = 0.025
AXES_HEIGHT_FRACTION = AXES_TOP - AXES_BOTTOM


# Punkte -> Inch
# Berücksichtigt, dass die Achse nicht 100 % der Figure-Höhe nutzt
fig_height = max(
    7.0,
    (content_height_pt / 72) / AXES_HEIGHT_FRACTION
)


fig, ax = plt.subplots(
    figsize=(
        FIG_WIDTH,
        fig_height
    )
)


plt.subplots_adjust(
    left=0.025,
    right=0.985,
    top=AXES_TOP,
    bottom=AXES_BOTTOM
)


ax.set_xlim(0, 1)
ax.set_ylim(0, 1)
ax.axis("off")

fig.canvas.draw()


# ============================================================
# Horizontales Layout
# ============================================================

left_x = 0.045
left_w = 0.415

right_x = 0.555
right_w = 0.415

center_x = left_x + left_w / 2


# ============================================================
# Punktgrössen in endgültige Achsenkoordinaten umrechnen
# ============================================================

top_margin = pt_to_axes_y(
    ax,
    TOP_MARGIN_PT
)

start_h = pt_to_axes_y(
    ax,
    start_h_pt
)

for row in flow_rows_plot:

    row["left_h"] = pt_to_axes_y(
        ax,
        row["left_h_pt"]
    )

    row["right_h"] = pt_to_axes_y(
        ax,
        row["right_h_pt"]
    )

    row["vertical_gap"] = pt_to_axes_y(
        ax,
        row["gap_pt"]
    )


# ============================================================
# Startbox
# ============================================================

start_y = 1 - top_margin - start_h


draw_rect_box(
    ax,
    x=left_x,
    y=start_y,
    w=left_w,
    h=start_h,
    text=start_text,
    fontsize=MAIN_FONT_SIZE,
    lw=1.6,
    facecolor=STEP_BOX_COLOR,
    linespacing=LEFT_LINE_SPACING
)

previous_box_bottom = start_y


# ============================================================
# Ausschluss-Schritte zeichnen
# ============================================================

for i, row in enumerate(flow_rows_plot):

    is_last_step = (
        i == len(flow_rows_plot) - 1
    )

    left_h = row["left_h"]
    right_h = row["right_h"]
    vertical_gap = row["vertical_gap"]

    # Oberkante der nächsten linken Box.
    next_box_top = (
        previous_box_bottom
        - vertical_gap
    )

    # Unterkante / y-Position der nächsten linken Box.
    left_y = (
        next_box_top
        - left_h
    )

    # Horizontale Abzweigung exakt im Zentrum des freien Bereichs.
    branch_y = (
        previous_box_bottom
        + next_box_top
    ) / 2

    # Rechte Box exakt auf dieselbe y-Linie zentrieren.
    right_y = (
        branch_y
        - right_h / 2
    )

    # 1) Vertikaler Hauptpfeil: Boxkante -> Boxkante.
    draw_arrow(
        ax,
        center_x,
        previous_box_bottom,
        center_x,
        next_box_top,
        lw=LINE_LW,
        mutation_scale=14
    )

    # 2) Horizontaler Ausschlusspfeil: Hauptlinie -> linke Kante
    #    der rechten Box, exakt auf deren vertikaler Mitte.
    draw_arrow(
        ax,
        center_x,
        branch_y,
        right_x,
        branch_y,
        lw=LINE_LW,
        mutation_scale=13
    )

    # Rechte Ausschlussbox.
    draw_exclusion_box(
        ax,
        x=right_x,
        y=right_y,
        w=right_w,
        h=right_h,
        text=row["right_text"],
        lw=1.3,
        fontsize=DETAIL_FONT_SIZE,
        linespacing=RIGHT_LINE_SPACING
    )

    # Linke Kohortenbox.
    draw_rect_box(
        ax,
        x=left_x,
        y=left_y,
        w=left_w,
        h=left_h,
        text=row["left_text"],
        fontsize=MAIN_FONT_SIZE,
        lw=(1.8 if is_last_step else 1.4),
        facecolor=(
            FINAL_BOX_COLOR
            if is_last_step
            else STEP_BOX_COLOR
        ),
        linespacing=LEFT_LINE_SPACING
    )

    previous_box_bottom = left_y


